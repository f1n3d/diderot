# The admin of the local Docmost instance that debug builds, UI tests and seed scripts sign in with (see README).
# Copy to .env, which isn't checked in, and keep it to yourself: chmod 600 .env
# Values are taken as written: no $ expansion and no comments after them; quotes around a value are optional.
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=

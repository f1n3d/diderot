          }
        }
      }
    },
    "This server uses HTTP: your password and your session travel over the network unencrypted. Only continue in a network you trust, such as your own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server nutzt HTTP: Dein Passwort und deine Sitzung gehen unverschlüsselt durchs Netz. Fahre nur in einem Netz fort, dem du vertraust, etwa deinem eigenen."
